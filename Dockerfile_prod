# Stage 1: Build Stage
FROM node:20-alpine AS builder
WORKDIR /app

# Copy and install dependencies
COPY package.json package-lock.json ./
RUN npm ci

# Copy the rest of the application and build
COPY . .
# You must set environment variables here if they are 'build-time' variables (NEXT_PUBLIC_...)
# RUN NEXT_PUBLIC_SPRING_API=... npm run build
RUN npm run build 

# Stage 2: Production Stage
FROM node:20-alpine AS runner
WORKDIR /app

# Create a non-root user for security (best practice for enterprise containers)
RUN addgroup --system nextjs \
    && adduser --system --uid 1001 nextjs
USER nextjs

# Copy standalone files from the builder stage
# These paths are crucial for the 'standalone' output to work
COPY --from=builder --chown=nextjs:nextjs /app/public ./public
COPY --from=builder --chown=nextjs:nextjs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nextjs /app/.next/static ./.next/static

# Set 'runtime' environment variables via container configuration (e.g., Spring Boot URL)
# The Next.js server will use these
ENV PORT 3000
EXPOSE 3000

CMD ["node", "server.js"]