# Copy this file to .env.local and fill in real values
# .env.local is gitignored - never commit real credentials

# ── Development auth bypass ──────────────────────────────────────────────────
BYPASS_AUTH=true
NEXT_PUBLIC_DEV_ROLE=managers

# ── AI Agent (AWS) ───────────────────────────────────────────────────────────
# AWS region for S3 and DynamoDB
AWS_REGION=us-east-1

# S3 bucket where work record JSON is dropped to trigger the Strands agent
AI_AGENT_S3_BUCKET=your-agent-input-bucket-name

# API Gateway endpoint that accepts { dln, taxPrd } and returns recommendations
AI_AGENT_API_GATEWAY_URL=https://your-api-gateway-id.execute-api.us-gov-west-1.amazonaws.com/stage/v1/tp/1040x/agent/recommendation

# AWS credentials — use IAM roles / instance profiles in non-local environments
# For local development, configure via ~/.aws/credentials or AWS_PROFILE
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...        # required for temporary credentials
