{
  "name": "irs-error-resolution",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-4003} --turbopack",
    "build": "next build --turbopack",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint",
    "docker:build": "docker build -t irs-error-resolution .",
    "docker:run": "docker run -p 4003:3000 irs-error-resolution",
    "docker:dev": "docker-compose --profile dev up --build",
    "docker:prod": "docker-compose up --build",
    "dev:no-auth": "BYPASS_AUTH=true npm run dev",
    "dev:with-auth": "npm run dev"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^0.542.0",
    "next": "15.5.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
